BOT_TOKEN=telegram_bot_token_from_BotFather
OPENAI_API_KEY=sk-your_key_here
OWNER_TELEGRAM_ID=123456789
OPENAI_MODEL=gpt-6-luna
# Literary generation (Polza). API token is private: set in BotHost, NOT in Git.
POLZA_API_KEY=pza-your_key_here
GENERATION_PROVIDER=polza
GENERATION_MODEL=google/gemini-3.7-flash
POLZA_BASE_URL=https://polza.ai/api/v1
# The selected generation model is persisted beside SQLite without altering it.
# GENERATION_MODEL_CONFIG=/app/data/generation_model.json
MEMORY_MODEL=gpt-6-luna
DATABASE_PATH=/app/data/roleplay.sqlite3
# To intentionally create a NEW database on a fresh install, set true ONCE; remove afterward.
# ALLOW_NEW_DATABASE=true
VISION_MODEL=gpt-6-luna
# Local character portraits; keep alongside the database in persistent storage
# MEDIA_DIR=/app/data/portraits
AUTO_MEMORY=true
MAX_OUTPUT_TOKENS=8192
# Auto-continue if the model response hits max_tokens. No rerolls or new story turns.
GENERATION_AUTO_CONTINUES=3
GENERATION_CONTINUE_TOKENS=8192
# v0.4: examples in style menu + indexed recall + inspect actual prompt
PROMPT_DEBUG=true
STYLE_EXAMPLES=2
RECENT_TURNS=8
RECALLED_TURNS=3
PROMPT_MAX_CHARS=29000
