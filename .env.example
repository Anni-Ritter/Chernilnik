BOT_TOKEN=
OWNER_TELEGRAM_ID=
OPENAI_API_KEY=
POLZA_API_KEY=

# Локально можно так; на BotHost — /app/data/roleplay.sqlite3
DATABASE_PATH=./data/roleplay.sqlite3
MEDIA_DIR=./data/portraits

# Только при первом создании пустой БД, потом убери
ALLOW_NEW_DATABASE=true

OPENAI_MODEL=gpt-6-luna
MEMORY_MODEL=gpt-6-luna
VISION_MODEL=gpt-6-luna

GENERATION_PROVIDER=polza
GENERATION_MODEL=google/gemini-3.7-flash
POLZA_BASE_URL=https://polza.ai/api/v1

AUTO_MEMORY=true
MAX_OUTPUT_TOKENS=1800
